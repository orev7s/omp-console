[Unit]
Description=OMP Console Caddy TLS front
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=caddy
Group=caddy
Environment=HOME=@CADDY_DATA_DIR@
Environment=XDG_DATA_HOME=@CADDY_DATA_DIR@/.local/share
Environment=XDG_CONFIG_HOME=@CADDY_DATA_DIR@/.config
EnvironmentFile=@CADDY_ENV_FILE@
ExecStart=@CADDY_BIN@ run --config @CADDY_CONF_FILE@ --adapter caddyfile
ExecReload=@CADDY_BIN@ reload --config @CADDY_CONF_FILE@ --adapter caddyfile
Restart=on-failure
RestartSec=5

# Bind 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=@CADDY_DATA_DIR@

[Install]
WantedBy=multi-user.target